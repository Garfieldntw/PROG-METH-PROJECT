<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry excluding="res/|res/GameAudio/|res/Map/" kind="src" path="src"/>
	<classpathentry excluding="GameAudio/|Map/" kind="src" path="src/res"/>
	<classpathentry kind="src" path="src/res/GameAudio"/>
	<classpathentry kind="src" path="src/res/Map"/>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JRE + JAVAFX">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="output" path="bin"/>
</classpath>
